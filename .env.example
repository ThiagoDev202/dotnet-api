# Copie este arquivo para .env e ajuste os valores antes de rodar docker compose up
# O arquivo .env nunca deve ser commitado (está no .gitignore)

# Senha do postgres (superuser — usado apenas para executar as migrations no startup)
POSTGRES_PASSWORD=troque_esta_senha_postgres

# Senha da role de runtime orders_app (conexão da aplicação, com RLS enforced).
# OBRIGATÓRIO: deve ser definido no .env — o compose falha explicitamente se ausente.
# Após trocar este valor, a migration ParametrizeSenhaOrdersApp atualiza a senha
# da role no banco via set_config('app.orders_app_password').
APP_DB_PASSWORD=troque_esta_senha_orders_app_min16chars

# Chave secreta do JWT — mínimo 32 caracteres, use valor aleatório em produção.
# Gere com: openssl rand -base64 32
JWT_KEY=troque-esta-chave-jwt-minimo-32-caracteres-aqui
